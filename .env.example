# Required for stable sessions when restarting or running multiple workers.
# Use a long, random secret. Never commit the real value.
SESSION_SECRET=

# Set true behind HTTPS in production. Keep false for plain HTTP localhost.
COOKIE_SECURE=false

# Public origin (scheme + host, no path), required behind HTTPS reverse proxies.
# Example: https://analytics.example.com. Leave blank for local development.
PUBLIC_ORIGIN=

# Customer accounts and durable analytics workspaces.
# Reuse the Supabase project containing existing customer accounts.
# Apply database/workspaces.sql in its SQL editor before using saved workspaces.
# Use its public anon/publishable key, never a service-role key.
# Real values belong only in .env or your hosting provider's environment settings.
SUPABASE_URL=
SUPABASE_KEY=

# Optional AI questions. CSV profiling works without these values.
# Choose a Responses-compatible OpenAI model available to your API account.
OPENAI_API_KEY=
OPENAI_MODEL=

# Private access token required before any paid AI call.
# Set a long random value and share it only with authorized analysts.
ANALYST_ACCESS_TOKEN=

# Optional SQLite path for temporary, session-owned guest reports and AI limits.
# Default: instance/analysis.sqlite3. Guest reports expire after one hour.
# Signed-in customer workspaces are saved to Supabase, never this local file.
# Render's application filesystem is temporary across deploys and restarts.
# ANALYSIS_DB_PATH=
